    <!-- LEFT WHEEL LINK -->

    <!-- Joint from urdf_rigid_v2 to urdf_drve_wheel_assembly --> 
    <joint name="wheelleft_speed" type="continuous">
        <origin xyz="0 0.313 0" rpy="-${pi/2} 0 0"/>
        <parent link="base_link"/> 
        <child link="urdf_drve_wheel_assembly"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- Link urdf_drve_wheel_assembly -->
    <link name="urdf_drve_wheel_assembly">  
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="2.46468"/>
            <inertia ixx="0.0210846" ixy="-9.45889e-10" ixz="-2.03772e-09" iyy="0.0132215" iyz="5.21376e-10" izz="0.0132215"/>
        </inertial>

